<odoo>
    <record id="workout_menu_action" model="ir.actions.act_window">
        <field name="name">Workout</field>
        <field name="res_model">workout</field>
        <field name="view_mode">form</field>
    </record>
    <record id="workout_history_menu_action" model="ir.actions.act_window">
        <field name="name">Workouts History</field>
        <field name="res_model">workout</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="muscle_group_menu_action" model="ir.actions.act_window">
        <field name="name">Muscle Groups</field>
        <field name="res_model">muscle_group</field>
        <field name="view_mode">list</field>
    </record>
    <record id="exercise_menu_action" model="ir.actions.act_window">
        <field name="name">Exercises</field>
        <field name="res_model">exercise</field>
        <field name="view_mode">list</field>
    </record>
    <record id="location_menu_action" model="ir.actions.act_window">
        <field name="name">Gym / Location</field>
        <field name="res_model">location</field>
        <field name="view_mode">list</field>
    </record>

    <menuitem id="exercise" name="Exercise Workouts">
        <menuitem id="workouts_menu" name="Workout">
            <menuitem name="Workout" id="workout_form_menu" action="workout_menu_action"/>
            <menuitem name="Workout History" id="workout_list_menu" action="workout_history_menu_action"/>
        </menuitem>
        <menuitem id="configuration_menu" name="Configuration">
            <menuitem name="Muscle Groups" id="muscle_group_sub_menu" action="muscle_group_menu_action"/>
            <menuitem name="Exercises" id="exercise_sub_menu" action="exercise_menu_action"/>
            <menuitem name="Gyms/Locations" id="location_sub_menu" action="location_menu_action"/>
        </menuitem>
    </menuitem>
</odoo>