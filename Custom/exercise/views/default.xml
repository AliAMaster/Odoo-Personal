<odoo>
    <data>
        <!--Muscle Group List View-->
        <record id="muscle_group_view_list" model="ir.ui.view">
            <field name="name">muscle_group.list</field>
            <field name="model">muscle_group</field>
            <field name="arch" type="xml">
                <list editable="bottom">
                    <field name="name"/>
                </list>
            </field>
        </record>
        <!--Exercise List View-->
        <record id="exercise_view_list" model="ir.ui.view">
            <field name="name">exercise.list</field>
            <field name="model">exercise</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="muscle_group" widget="many2many_tags"/>
                </list>
            </field>
        </record>
        <!--Exercise Form View-->
        <record id="exercise_view_form" model="ir.ui.view">
            <field name="name">exercise.form</field>
            <field name="model">exercise</field>
            <field name="arch" type="xml">
                <form>
                    <field name="name"/>
                    <field name="muscle_group" widget="many2many_tags"/>
                    <field name="sets" nolabel="1"/>
                </form>
            </field>
        </record>
        <!--Gym List View-->
        <record id="location_view_list" model="ir.ui.view">
            <field name="name">location.list</field>
            <field name="model">location</field>
            <field name="arch" type="xml">
                <list editable="bottom">
                    <field name="name"/>
                </list>
            </field>
        </record>
        <!--Set List View-->
        <record id="set_view_list" model="ir.ui.view">
            <field name="name">set.list</field>
            <field name="model">set</field>
            <field name="arch" type="xml">
                <list editable="bottom">
                    <field name="exercise"/>
                    <field name="weight"/>
                    <field name="weight_uom"/>
                    <field name="repetition"/>
                </list>
            </field>
        </record>
        <!--Workout List View-->
        <record id="workout_view_list" model="ir.ui.view">
            <field name="name">workout.list</field>
            <field name="model">workout</field>
            <field name="arch" type="xml">
                <list>
                    <field name="sequence"/>
                    <field name="date_time"/>
                    <field name="location"/>
                </list>
            </field>
        </record>
        <!--Workout Form View-->
        <record id="workout_view_form" model="ir.ui.view">
            <field name="name">workout.form</field>
            <field name="model">workout</field>
            <field name="arch" type="xml">
                <form>
                    <field name="location" nolabel="0"/>
                    <field name="date_time"/>
                    <field name="set" nolabel="1"/>
                </form>
            </field>
        </record>
    </data>
</odoo>