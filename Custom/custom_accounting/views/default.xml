<odoo>
    <data>
        <record id="custom_account_view_tree" model="ir.ui.view">
            <field name="name">Account.List</field>
            <field name="model">custom.account</field>
            <field name="arch" type="xml">
                <list string="Account List">
                    <field name="name"/>
                    <field name="balance" widget="monetary" options="{'currency_field': 'currency'}"/>
                    <field name="currency" invisible="1" column_invisible="1"/>
                </list>
            </field>
        </record>

        <record id="custom_account_view_form" model="ir.ui.view">
            <field name="name">Account.Form</field>
            <field name="model">custom.account</field>
            <field name="arch" type="xml">
                <form string="Account Form">
                    <sheet>
                        <group col="2">
                            <div style="width: 70%">
                                <h1>
                                    <field name="name"/>
                                </h1>
                            </div>
                            <field name="balance" widget="monetary" options="{'currency_field': 'currency'}"/>
                        </group>
                        <group>
                            <group>
                                <field name="parent_account" nolabel="0"/>
                            </group>
                            <group>
                                <field name="currency"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Credit">
                                <field name="credit_entries" nolabel="1"/>
                            </page>
                            <page string="Debit">
                                <field name="debit_entries" nolabel="1"/>
                            </page>
                            <page string="Child Accounts">
                                <field name="child_accounts" nolabel="1" editable="0"/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

    </data>
</odoo>
