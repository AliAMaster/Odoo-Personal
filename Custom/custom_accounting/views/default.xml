<odoo>
    <data>
        <!--Account Default List View-->
        <record id="custom_account_view_tree" model="ir.ui.view">
            <field name="name">custom.account.list</field>
            <field name="model">custom.account</field>
            <field name="arch" type="xml">
                <list string="Account List">
                    <field name="name"/>
                    <field name="currency"/>
                    <field name="account_type"/>
                </list>
            </field>
        </record>
        <!--Account Default Form View-->
        <record id="custom_account_view_form" model="ir.ui.view">
            <field name="name">custom.account.form</field>
            <field name="model">custom.account</field>
            <field name="arch" type="xml">
                <form string="Account Form">
                    <sheet>
                        <group col="2">
                            <div style="width: 70%">
                                <h1>
                                    <field name="name"/>
                                </h1>
                            </div>
                        </group>
                        <group>
                            <group>
                                <field name="parent_account"/>
                            </group>
                            <group>
                                <field name="account_type"/>
                            </group>
                            <group>
                                <field name="currency"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Credit">
                                <field name="credit_entries" nolabel="1"/>
                            </page>
                            <page string="Debit">
                                <field name="debit_entries" nolabel="1"/>
                            </page>
                            <page string="Child Accounts">
                                <field name="child_accounts" nolabel="1" editable="0"/>
                            </page>
                            <page string="Balance">
                                <field name="balance" nolabel="1" mode="list" readonly="1" context="{'create': False, 'delete': False}"/>
                                <button name="rebuild_balances" type="object" string="Rebuild Balance"
                                        class="btn-primary"/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>
        <!--Entry List View-->
        <record id="custom_entry_view_list" model="ir.ui.view">
            <field name="name">custom.entry.list</field>
            <field name="model">custom.entry</field>
            <field name="arch" type="xml">
                <list>
                    <field name="sequence" string="#"/>
                    <field name="amount"/>
                    <field name="currency" string="Currency"/>
                    <field name="credit_account" string="From"/>
                    <field name="debit_account" string="To"/>
                    <field name="remark"/>
                </list>
            </field>
        </record>
        <!--Entry Form View-->
        <record id="custom_entry_view_form" model="ir.ui.view">
            <field name="name">custom.entry.form</field>
            <field name="model">custom.entry</field>
            <field name="arch" type="xml">
                <form>
                    <group>
                        <group>
                            <field name="amount"/>
                            <field name="currency" string="Currency"/>
                            <field name="transaction_date"/>
                        </group>
                        <group>
                            <field name="credit_account" string="From"/>
                            <field name="debit_account" string="To"/>
                            <field name="remark"/>
                        </group>
                    </group>
                </form>
            </field>
        </record>
        <!--Balance List View-->
        <record id="custom_balance_view_list" model="ir.ui.view">
            <field name="name">custom.account_balance.list</field>
            <field name="model">custom.account_balance</field>
            <field name="arch" type="xml">
                <list create="false" delete="false" edit="false">
                    <field name="amount"/>
                    <field name="currency"/>
                </list>
            </field>
        </record>
    </data>
</odoo>
