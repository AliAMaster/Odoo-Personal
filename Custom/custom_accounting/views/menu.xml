<odoo>
    <record id="account_menu_action" model="ir.actions.act_window">
        <field name="name">Accounts</field>
        <field name="res_model">custom.account</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="account_type_menu_action" model="ir.actions.act_window">
        <field name="name">Account Types</field>
        <field name="res_model">custom.account_type</field>
        <field name="view_mode">list</field>
    </record>
        <record id="entry_menu_action" model="ir.actions.act_window">
        <field name="name">Entries</field>
        <field name="res_model">custom.entry</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="custom_accounting" name="Accounting">
        <menuitem id="accounts_menu" name="Accounts">
            <menuitem name="Accounts" id="accounts_sub_menu" action="account_menu_action"/>
            <menuitem name="Account Types" id="account_type_sub_menu" action="account_type_menu_action"/>
        </menuitem>
        <menuitem id="entry_menu" name="Entries">
            <menuitem name="Entries" id="entries_sub_menu" action="entry_menu_action"/>
        </menuitem>
    </menuitem>
</odoo>